# SMTP2Go Settings
# Get your credentials from: https://app.smtp2go.com/settings/users
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USER=your_smtp2go_username
SMTP_PASS=your_smtp2go_password

# Email Configuration
SMTP_FROM_EMAIL=noreply@webxexpert.com
SMTP_FROM_NAME=WebXExpert
SMTP_TO_EMAIL=hello@webxexpert.com

# Optional: Webhook URL for integrations (Zapier, Make, n8n)
# WEBHOOK_URL=https://hooks.zapier.com/...

# Site URL (for production)
NEXT_PUBLIC_SITE_URL=https://webxexpert.com
